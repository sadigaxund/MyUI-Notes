# syntax=docker/dockerfile:1

# code-server (vsnote) — specialized locked-down editor image.
#
# Same source build as the main Dockerfile, but the runtime differs:
#   - no terminal, debugger, or task runners (patches/)
#   - no extension marketplace or installs (patches/no-marketplace.diff)
#   - heavy IntelliSense language servers stripped (ci/build/strip-extensions.sh)
#   - image-defined workspace baked in (preset/workspace)
#   - preset user settings seeded on first run (preset/settings.json)
#   - release runtime layout: reh-web artifact as lib/vscode, prod-only deps
#
# Build:
#   VSCODE_COMMIT="$(git ls-tree HEAD lib/vscode | awk '{print $3}')"
#   docker build -f Dockerfile.specialized \
#     --build-arg VSCODE_COMMIT="$VSCODE_COMMIT" -t sakhund/vsnote:specialized .
#
# Run:
#   docker run -it --rm -p 8080:8080 -e PASSWORD=secret sakhund/vsnote:specialized

ARG VSCODE_COMMIT=df53daabb18cd157bdb08c7f01c34df936cf12f4
ARG VERSION=0.0.0
ARG NODE_IMAGE=node:24.18.0-bookworm-slim
ARG RUNTIME_IMAGE=debian:bookworm-slim

###############################################################################
# Build stage: compile VS Code and code-server (identical to main Dockerfile)
###############################################################################
FROM ${NODE_IMAGE} AS build

ARG VSCODE_COMMIT
ARG VERSION

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential \
    python3 \
    pkg-config \
    libx11-dev \
    libxkbfile-dev \
    libsecret-1-dev \
    libkrb5-dev \
    quilt \
    git \
    ca-certificates \
    curl \
    jq \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY ci ./ci
COPY package.json package-lock.json ./
COPY test/package.json test/package-lock.json ./test/
COPY test/e2e/extensions/test-extension/package.json \
     test/e2e/extensions/test-extension/package-lock.json \
     ./test/e2e/extensions/test-extension/
RUN --mount=type=cache,target=/root/.npm SKIP_SUBMODULE_DEPS=1 npm ci

COPY patches ./patches
RUN git init -q \
  && git config user.email "build@local" \
  && git config user.name "build" \
  && git add -A \
  && git commit -q -m build

RUN git init -q lib/vscode \
  && git -C lib/vscode remote add origin https://github.com/microsoft/vscode.git \
  && git -C lib/vscode fetch --depth 1 origin "${VSCODE_COMMIT}" \
  && git -C lib/vscode checkout -q FETCH_HEAD \
  && git -C lib/vscode reset -q --hard FETCH_HEAD

RUN quilt push -a

RUN --mount=type=cache,target=/root/.npm npm --prefix lib/vscode install

RUN VERSION="${VERSION}" npm run build:vscode \
  && npm run build

COPY . .

RUN npm run build

###############################################################################
# Specialization: strip heavy extensions, prune dev deps, switch to the
# release layout (reh-web artifact becomes lib/vscode).
###############################################################################
RUN ARCH="$(uname -m)"; case "${ARCH}" in x86_64) vscode_arch=x64;; aarch64) vscode_arch=arm64;; *) echo "unsupported arch ${ARCH}" >&2; exit 1;; esac \
  && bash ci/build/strip-extensions.sh "lib/vscode-reh-web-linux-${vscode_arch}/extensions" \
  && npm prune --omit=dev \
  && rm -rf \
    lib/vscode \
    lib/vscode-reh-web-linux-x64 \
    lib/vscode-reh-web-linux-arm64 \
    test \
  && mv "lib/vscode-reh-web-linux-${vscode_arch}" lib/vscode

###############################################################################
# Runtime stage: minimal packages, baked-in workspace and preset
###############################################################################
FROM ${NODE_IMAGE} AS node-runtime

FROM ${RUNTIME_IMAGE} AS runtime

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    dumb-init \
    passwd \
    ca-certificates \
    curl \
    git \
    locales \
    libkrb5-3 \
  && sed -i 's/# en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen \
  && locale-gen \
  && rm -rf /var/lib/apt/lists/*

ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node

COPY --from=build /src/out /usr/local/lib/code-server/out
COPY --from=build /src/node_modules /usr/local/lib/code-server/node_modules
COPY --from=build /src/package.json /usr/local/lib/code-server/package.json
COPY --from=build /src/lib/vscode /usr/local/lib/code-server/lib/vscode
COPY --from=build /src/src/browser/pages /usr/local/lib/code-server/src/browser/pages
COPY docker-entrypoint.sh /usr/local/bin/entrypoint.sh

# Image-defined workspace and preset settings/extensions.
COPY preset/settings.json /opt/vsnote/preset/settings.json
COPY preset/workspace /workspace

RUN chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /usr/local/lib/code-server

# --- runtime configuration (all overridable via -e) --------------------------
ENV PUID=1000 \
    PGID=1000 \
    AUTH=password \
    PORT=8080 \
    BIND_ADDR=0.0.0.0 \
    USER_DATA_DIR=/var/lib/code-server/data \
    EXTENSIONS_DIR=/var/lib/code-server/data/extensions \
    CONFIG=/var/lib/code-server/config.yaml \
    DISABLE_TELEMETRY=false \
    WORKSPACE=/workspace \
    PRESET_DIR=/opt/vsnote/preset

VOLUME ["/var/lib/code-server"]

EXPOSE 8080

HEALTHCHECK CMD curl -fsS "http://127.0.0.1:${PORT}/healthz" || exit 1

ENTRYPOINT ["dumb-init", "--", "/usr/local/bin/entrypoint.sh"]
